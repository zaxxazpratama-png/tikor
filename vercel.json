{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.2" },
    "*.php":     { "runtime": "vercel-php@0.7.2" }
  },
  "routes": [
    { "src": "/.*\\.sql$", "status": 403, "headers": { "Content-Type": "text/plain" }, "dest": "/403.php" },
    { "src": "/.*\\.py$",  "status": 403, "headers": { "Content-Type": "text/plain" }, "dest": "/403.php" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)\\.php", "dest": "/$1.php" },
    { "src": "/",           "dest": "/index.php" },
    { "src": "/(.*)",       "dest": "/$1" }
  ]
}
